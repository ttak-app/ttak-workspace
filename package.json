{
  "name": "ttak-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev:web": "npm run dev --workspace=@ttak/web",
    "build:web": "npm run build --workspace=@ttak/web",
    "lint:web": "npm run lint --workspace=@ttak/web",
    "preview:web": "npm run preview --workspace=@ttak/web",
    "check-types:web": "npm exec --workspace=@ttak/web -- tsc -b --noEmit",
    "format:web": "npm run format --workspace=@ttak/web",
    "format:check:web": "npm run format:check --workspace=@ttak/web",
    "format:macos": "xcrun swift format format --configuration apps/macos/.swift-format --in-place --recursive apps/macos/Ttak apps/macos/TtakTests",
    "format:check:macos": "xcrun swift format lint --configuration apps/macos/.swift-format --strict --recursive apps/macos/Ttak apps/macos/TtakTests",
    "macos:build": "node tools/macos/check.mjs build",
    "macos:test": "node tools/macos/check.mjs test",
    "review:scope": "node tools/ai-workflow/collect.mjs",
    "workflow:resume": "node tools/ai-workflow/resume.mjs",
    "workflow:check": "node tools/ai-workflow/record.mjs check",
    "workflow:review": "node tools/ai-workflow/record.mjs review",
    "workflow:pr-check": "node tools/ai-workflow/pr-check.mjs",
    "workflow:harness-check": "node tools/ai-workflow/harness-check.mjs",
    "workflow:test": "node --test tools/ai-workflow/*.test.mjs tools/macos/*.test.mjs",
    "tokens:build": "node tools/design-tokens/build.mjs",
    "tokens:check": "node tools/design-tokens/build.mjs --check && node --test tools/design-tokens/*.test.mjs"
  }
}
